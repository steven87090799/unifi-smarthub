# ===== 伺服器 =====
PORT=3000
# 資料持久化目錄 (Docker 部署維持 /app/data，對應 compose 的 volume)
# DATA_DIR=/app/data

# ===== Debug / Structured Logging / System Monitoring =====
# 日誌等級：DEBUG | INFO | WARNING | ERROR | CRITICAL。正式環境建議 WARNING；追查 task 全流程時暫改 DEBUG。
LOG_LEVEL=WARNING
# console 供 docker logs 人工閱讀；json 可直接串 Loki / ELK / OpenSearch。
LOG_FORMAT=console
LOG_JSON=false
# 0 可關閉 API request completion log；成功 request 在 DEBUG，4xx/5xx 仍依等級輸出。
DEBUG_HTTP=1

# 資源監控預設每 30 秒取樣，保留最近 60 筆於記憶體；設 false 可停用背景取樣。
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=30
CPU_WARNING_PERCENT=80
CPU_CRITICAL_PERCENT=95
MEMORY_WARNING_PERCENT=80
MEMORY_CRITICAL_PERCENT=90
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
# SQLite 健康檢查與慢查詢門檻；better-sqlite3 是單連線，沒有外部 connection pool。
DB_LATENCY_WARNING_MS=500
DB_LATENCY_CRITICAL_MS=2000
DB_SLOW_QUERY_MS=1000
# 背景工作超過此秒數未更新 heartbeat 才視為 stuck；一般 long-running 不會只因執行久就告警。
TASK_STUCK_SECONDS=1800
# 相同 active issue 在 cooldown 內只累計 occurrences，不重複洗版。
ALERT_COOLDOWN_SECONDS=300

# ===== 1. 硬體監控與溫度擷取 (UCG-Ultra 實體機 SSH) =====
UCG_IP=192.168.1.1
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_ucg_ssh_password
# WAN 網卡介面名稱 (硬體頁 WAN 標籤用；UCG-Ultra 通常為 eth4)
WAN_IFACE=eth4

# ===== 2. 本地網路控制 (UniFi Local Controller API 登入) =====
# 用於控制 WiFi 廣播、PoE 斷電、讀取客戶端與威脅防禦清單
# 若為 UniFi OS 裝置 (UCG/UDM)，URL 通常是 https://<ip>
UNIFI_CONTROLLER_URL=https://192.168.1.1:443
UNIFI_USERNAME=your_local_controller_username
UNIFI_PASSWORD=your_local_controller_password

# ===== 3. 雲端備用 (UniFi 官方 Site Manager API，選填) =====
# 未填或保留 your_unifi 佔位字串時，雲端頁自動回退至展示用假資料
UNIFI_API_KEY=your_unifi_official_api_key_here

# ===== 4. 綠聯 UGREEN NAS (UGOS Pro，選填) =====
# 未填 NAS_HOST/NAS_USER/NAS_PASSWORD 時，NAS 頁自動回退至展示用假資料
# 注意：UGOS 密碼不可包含 # * § 等特殊字元
NAS_HOST=192.168.1.50
NAS_PORT=9443
NAS_SCHEME=https
NAS_USER=monitor
NAS_PASSWORD=your_nas_password

# ===== 5. NAS Monitor 中介層 (nas-monitor-interface，選填，提供進階功能) =====
# 另外部署的 Flask 中介層，提供 Docker 管理、流量/儲存/溫度歷史、滿載預測、警報等
# 未設定時，NAS 頁的進階區塊 (Docker/歷史圖/警報) 顯示展示用假資料
NAS_MONITOR_URL=http://192.168.1.50:8000
NAS_MONITOR_API_KEY=your_nas_monitor_api_key
# 只使用本專案內建 Docker Monitor 時設 docker_only；完整外部 NAS Monitor 設 full
NAS_MONITOR_MODE=docker_only

# ===== 7. CyberPower UPS (選填，NUT 架構) =====
# UPS_SOURCE: auto(依序嘗試 nut→pwrstat→pmset) | nut | pwrstat | pmset
# NUT 方案: brew install nut → ups.conf 設 [cyberpower] driver=usbhid-ups port=auto → brew services start nut
# Docker 部署時 NUT 跑宿主機，容器設 NUT_HOST=host.docker.internal
UPS_SOURCE=auto
NUT_HOST=localhost
NUT_UPS_NAME=cyberpower
# PWRSTAT_PATH=/usr/local/bin/pwrstat

# ===== 通知推播 =====
# 無需在此設定：在網頁「通知推播」頁填寫 Discord/Telegram/Webhook 即可，設定存於 data/notification-settings.json

# ===== 6. WiiM 串流音響 (選填) =====
# 未填時預設為 192.168.0.170。若連線失敗或未設定，系統會自動以模擬數據代替，確保功能預覽正常運作
WIIM_IP=192.168.0.170

# ===== 8. CyberPower PowerPanel Business REST API (選填，UPS 資料來源之一) =====
# 若 PowerPanel Business 跑在別台機器 (例如你的電腦)，PPB_HOST 填該機器 IP
# Docker 部署時不可用 127.0.0.1 (容器內的 127.0.0.1 是容器自己)
# PPB_HOST=192.168.1.100
# PPB_PORT=3052
# PPB_USER=your_ppb_username
# PPB_PASSWORD=your_ppb_password

# ===== 9. AdGuard Home DNS 防護 (選填) =====
# 填入後啟用「AdGuard DNS」頁：攔截統計、查詢/攔截日誌、保護開關
# ADGUARD_HOST=192.168.1.250
# ADGUARD_PORT=80
# ADGUARD_USER=your_adguard_username
# ADGUARD_PASSWORD=your_adguard_password

# ===== 10. Linux 小主機監控 (選填，SSH) =====
# 填入後啟用「Linux 小主機」頁：CPU/溫度/記憶體/磁碟/負載監控與歷史圖
# LINUX_HOST=192.168.1.37
# LINUX_SSH_PORT=22
# LINUX_SSH_USER=your_linux_username
# LINUX_SSH_PASSWORD=your_linux_password

# ===== 11. 面板存取密碼 (選填但強烈建議) =====
# 設定後整站需要 Basic Auth 登入 (帳號任意、密碼為此值)；/healthz 不受影響
# 此面板有斷網/關WiFi/PoE斷電等控制權限，部署到 NAS 後建議必設
# PANEL_PASSWORD=your_panel_password
