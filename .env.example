# ===== Docker Compose 部署參數 =====
# 將本範例複製為 config/.env；Compose 一律搭配 --env-file config/.env，
# 並把同一個 config 目錄掛入容器。不要保留第二份根目錄 .env。
SMARTHUB_CONFIG_DIR=./config
# The normal NAS path uses the GHCR stable channel published after the main
# branch passes SmartHub CI. Set one tag here for both paired images, or run
# scripts/update-nas.sh --tag <tag> for a one-time update.
SMARTHUB_IMAGE_REPOSITORY=ghcr.io/steven87090799/unifi-smarthub
NAS_MONITOR_IMAGE_REPOSITORY=ghcr.io/steven87090799/unifi-smarthub-nas-monitor
SMARTHUB_IMAGE_TAG=stable
# 對外 port 可修改；不設時 compose 預設使用 3000。
SMARTHUB_HOST_PORT=3000
# Compose host-side publishing defaults to loopback. Set explicitly only when
# a reverse proxy or a separately controlled network boundary requires it.
SMARTHUB_HOST_BIND_ADDRESS=127.0.0.1
# Explicit bind address. Keep 0.0.0.0 only inside Docker; bind localhost for a local-only process.
SMARTHUB_BIND_ADDRESS=0.0.0.0
SMARTHUB_MEM_LIMIT=256m
# Optional local v2 backup scheduler. Keep disabled unless the destination is writable;
# mount SMARTHUB_BACKUP_DIR on a different storage system for disaster recovery.
SMARTHUB_BACKUP_SCHEDULE_ENABLED=false
SMARTHUB_BACKUP_INTERVAL_HOURS=24
SMARTHUB_BACKUP_RETENTION_COUNT=7
# SMARTHUB_BACKUP_DIR=/app/backups
# For a strict rollbackable deployment, replace the tag-based refs above with
# the paired registry digests captured from the same GitHub Actions release.
# SMARTHUB_IMAGE=ghcr.io/steven87090799/unifi-smarthub@sha256:<digest>
# NAS_MONITOR_IMAGE=ghcr.io/steven87090799/unifi-smarthub-nas-monitor@sha256:<digest>
# 內建 Docker Monitor 必須明確啟用：COMPOSE_PROFILES=nas-monitor，或啟動時加 --profile nas-monitor。
# COMPOSE_PROFILES=nas-monitor
# Linux 主機請將 GID 設為 Docker socket 的 numeric group ID；Docker Desktop/OrbStack 通常是 0。
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# DOCKER_SOCKET_GID=0

# ===== 伺服器 =====
PORT=3000
# 資料持久化目錄 (Docker 部署維持 /app/data，對應 compose 的 volume)
# DATA_DIR=/app/data
# UniFi device telemetry raw emergency cap; complete raw buckets are downsampled before deletion.
# It is separate from general history capacity because it scales with device count and sample cadence.
# UNIFI_TELEMETRY_HARD_CAP=100000

# ==================================================
# Trusted LAN compatibility mode
# 僅適合受控可信任內網：不需要自行管理 CA 與 SSH fingerprint。
# 只會對私有 IP、loopback、host.docker.internal 與 TRUSTED_LAN_HOSTS
# 的完全相符 hostname 套用；Site Manager、Telegram、Discord、Webhook、
# 外部圖片/CDN 與其他 Internet integration 永遠維持 TLS 驗證。
# 公開部署請設為 false，並使用正式 CA 與 SSH Host Key pinning。
TRUSTED_LAN_MODE=true
TRUSTED_LAN_HOSTS=
# 下方旗標是安全 baseline；Trusted LAN master switch 只在 private target
# 上產生 effective trusted-lan-insecure transport，不需要另外維護 insecure=true。
# 不要把這個模式理解成全域 NODE_TLS_REJECT_UNAUTHORIZED=0。

# ===== Debug / Structured Logging / System Monitoring =====
# 日誌等級：DEBUG | INFO | WARNING | ERROR | CRITICAL。正式環境建議 WARNING；追查 task 全流程時暫改 DEBUG。
LOG_LEVEL=WARNING
# console 供 docker logs 人工閱讀；json 可直接串 Loki / ELK / OpenSearch。
LOG_FORMAT=console
LOG_JSON=false
# 0 可關閉 API request completion log；成功 request 在 DEBUG，4xx/5xx 仍依等級輸出。
DEBUG_HTTP=1

# 資源監控預設每 30 秒取樣，保留最近 60 筆於記憶體；設 false 可停用背景取樣。
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=30
CPU_WARNING_PERCENT=80
CPU_CRITICAL_PERCENT=95
MEMORY_WARNING_PERCENT=80
MEMORY_CRITICAL_PERCENT=90
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
# SQLite 健康檢查與慢查詢門檻；better-sqlite3 是單連線，沒有外部 connection pool。
DB_LATENCY_WARNING_MS=500
DB_LATENCY_CRITICAL_MS=2000
DB_SLOW_QUERY_MS=1000
# 背景工作超過此秒數未更新 heartbeat 才視為 stuck；一般 long-running 不會只因執行久就告警。
TASK_STUCK_SECONDS=1800
# 相同 active issue 在 cooldown 內只累計 occurrences，不重複洗版。
ALERT_COOLDOWN_SECONDS=300

# ===== 1. 硬體監控與溫度擷取 (UCG-Ultra 實體機 SSH) =====
UCG_IP=192.168.1.1
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_ucg_ssh_password
# WAN 網卡介面名稱 (硬體頁 WAN 標籤用；UCG-Ultra 通常為 eth4)
WAN_IFACE=eth4

# ===== 2. 本地網路控制 (UniFi Local Controller API 登入) =====
# 用於控制 WiFi 廣播、PoE 斷電、讀取客戶端與威脅防禦清單
# 若為 UniFi OS 裝置 (UCG/UDM)，URL 通常是 https://<ip>
UNIFI_CONTROLLER_URL=https://192.168.1.1:443
UNIFI_USERNAME=your_local_controller_username
UNIFI_PASSWORD=your_local_controller_password
# TLS is verified by default. Trusted LAN derives scoped compatibility for private targets.
UNIFI_CONTROLLER_TLS_VERIFY=true
UNIFI_CONTROLLER_CA_FILE=
UNIFI_CONTROLLER_TLS_INSECURE=false
UNIFI_CONTROLLER_ALLOW_INSECURE_HTTP=false

# ===== 2a. UniFi 管理設備溫度 SSH（選填） =====
# 只會連線 Controller 已知、在線、且列在最多 32 個 MAC allowlist 的 literal IP。
# 指令固定為唯讀 thermal_zone 掃描；未支援裝置會顯示「不支援」，不會估算溫度。
UNIFI_DEVICE_SSH_PORT=22
UNIFI_DEVICE_SSH_USER=monitor
UNIFI_DEVICE_SSH_PASSWORD=your_unifi_device_ssh_password
# 逗號分隔 MAC；留空代表不啟用 Device SSH thermal。
UNIFI_DEVICE_SSH_TARGET_IDS=
# 選用的逐設備 Host Key pinning：mac=SHA256:fingerprint，逗號分隔。
UNIFI_DEVICE_SSH_HOST_KEYS=
UNIFI_DEVICE_SSH_ALLOW_UNPINNED=false

# ===== 2b. UniFi Network Integration API（臨時威脅來源 IPv4 封鎖，選填） =====
# 需要 UniFi Network 5.0.3+ 的 Integration API key，以及一個只讓 SmartHub 管理的
# IPV4_ADDRESSES Traffic Matching List。防火牆 policy 必須事先指向該清單。
# API URL 可留空；此時會由 UNIFI_CONTROLLER_URL 推導 /proxy/network/integration。
# 專用清單不要混入人工規則；空清單會保留 TEST-NET-1 sentinel 192.0.2.1 以符合 API minItems=1。
# UNIFI_NETWORK_API_URL=https://192.168.1.1/proxy/network/integration
# UNIFI_NETWORK_API_KEY=your_unifi_network_integration_api_key
# TLS 預設驗證；Trusted LAN master switch 只對分類為私有的 endpoint 產生 scoped 相容 transport，其他目標仍需明確 insecure opt-in。
UNIFI_NETWORK_TLS_VERIFY=true
UNIFI_NETWORK_CA_FILE=
UNIFI_NETWORK_TLS_INSECURE=false
UNIFI_NETWORK_ALLOW_INSECURE_HTTP=false
# UNIFI_NETWORK_SITE_ID=00000000-0000-0000-0000-000000000000
# UNIFI_THREAT_BLOCK_LIST_ID=00000000-0000-0000-0000-000000000000
UNIFI_THREAT_BLOCK_LIST_NAME=SmartHub Threat Blocks

# ===== 3. 雲端備用 (UniFi 官方 Site Manager API，選填) =====
# 未填或保留 your_unifi 佔位字串時，雲端頁回傳未設定/空狀態，不偽造正式資料
UNIFI_API_KEY=your_unifi_official_api_key_here

# ===== 4. 綠聯 UGREEN NAS (UGOS Pro，選填) =====
# 未填 NAS_HOST/NAS_USER/NAS_PASSWORD 時，NAS 頁回傳未設定/空狀態，不偽造正式資料
# 注意：UGOS 密碼不可包含 # * § 等特殊字元
NAS_HOST=192.168.1.50
NAS_PORT=9443
NAS_SCHEME=https
NAS_USER=monitor
NAS_PASSWORD=your_nas_password
NAS_TLS_VERIFY=true
NAS_CA_FILE=
NAS_TLS_INSECURE=false
NAS_ALLOW_INSECURE_HTTP=false

# ===== 5. NAS Monitor 中介層 (選填，提供進階功能) =====
# 內建 Monitor：先用 openssl rand -hex 32 產生專用金鑰，再取消下列註解，並啟用 nas-monitor profile。
# NAS_MONITOR_URL=http://nas-monitor:8000
# NAS_MONITOR_API_KEY=
# NAS_MONITOR_MODE=docker_only
# 容器 mutation 預設關閉。若確實需要，先在目標容器加
# com.unifi.smarthub.nas-monitor.managed=true label，再同時設定以下兩行。
# NAS_MONITOR_MUTATIONS_ENABLED=true
# NAS_MONITOR_ACTION_ALLOW_LABELS=com.unifi.smarthub.nas-monitor.managed=true
# 容器 log 可能含 secret，預設關閉且使用獨立 allowlist；面板也只允許 admin 讀取。
# NAS_MONITOR_LOGS_ENABLED=true
# NAS_MONITOR_LOG_ALLOW_LABELS=com.unifi.smarthub.nas-monitor.logs=true
# Stop/restart 給 Docker 10 秒 graceful window；broker/client deadline 會再保留安全餘裕。
# NAS_MONITOR_ACTION_STOP_SECONDS=10
# 遠端 Monitor 請改為 VPN 內網位址或受信任 TLS 反向代理 URL，不要將 8000 直接暴露於公網。
# Trusted LAN 私有 endpoint 可由 master switch 使用 scoped HTTP；其他 VPN 內若只能使用 HTTP，才明確設 true；API key 仍是明文傳輸。
# NAS_MONITOR_ALLOW_INSECURE_HTTP=true
# TLS 預設驗證；Trusted LAN 私有 endpoint 可由 master switch 使用 scoped 相容 transport；私有 CA 檔請放 config/ 並填容器內路徑，例如 /app/config/monitor-ca.pem。
# NAS_MONITOR_CA_FILE=
# NAS_MONITOR_TLS_INSECURE=true

# ===== 7. CyberPower UPS (選填) =====
# UPS_SOURCE: auto(依序嘗試 ppb→nut→pwrstat→pmset) | ppb | nut | pwrstat | pmset
# 明確來源預設 fail-closed；只有明確設 true 才允許 ppb/nut/pwrstat/pmset 失敗後回退。
UPS_ALLOW_FALLBACK=false
# Docker 已驗證路徑: UPS_SOURCE=ppb，並在下方設定 PPB_HOST=host.docker.internal、PPB_PORT=3052
# NUT 替代方案: NUT server 跑宿主機，容器的 NUT_HOST 必須填宿主機可達位址
UPS_SOURCE=ppb
# NUT_HOST=replace_with_a_host_reachable_from_the_container
# NUT_UPS_NAME=cyberpower
# PWRSTAT_PATH=/usr/local/bin/pwrstat

# ===== 通知推播 =====
# 無需在此設定：在網頁「通知推播」頁填寫 Discord/Telegram/Webhook 即可，設定存於 data/notification-settings.json

# ===== 6. WiiM 串流音響 (選填) =====
# 留空即停用；正式服務不以模擬數據代替未設定或連線失敗
# Optional WiiM Amp literal IP. Leave empty to disable the integration.
WIIM_IP=
# HTTPS certificate verification stays enabled by default; Trusted LAN derives scoped compatibility for private targets.
WIIM_TLS_INSECURE=false
# HTTP fallback is restricted to the configured private WiiM literal, never public artwork CDN URLs.
WIIM_ALLOW_INSECURE_HTTP=false

# ===== 8. CyberPower PowerPanel Business REST API (選填，UPS 資料來源之一) =====
# Docker 宿主機上的 PowerPanel Business 使用 host.docker.internal；若跑在別台機器則填該機器 IP
# Docker 部署時不可用 127.0.0.1 (容器內的 127.0.0.1 是容器自己)
PPB_HOST=host.docker.internal
PPB_PORT=3052
# PPB_USER=your_ppb_username
# PPB_PASSWORD=your_ppb_password
# Trusted LAN derives a scoped PPB compatibility agent for private targets.
PPB_TLS_VERIFY=true
# 自簽或私有 CA 建議掛載 CA 檔，而不是關閉驗證。
# PPB_CA_FILE=/app/config/ppb-ca.pem
PPB_TLS_INSECURE=false

# ===== 9. AdGuard Home DNS 防護 (選填) =====
# 填入後啟用「AdGuard DNS」頁：攔截統計、查詢/攔截日誌、保護開關
# 建議使用完整 HTTPS origin；舊 ADGUARD_HOST/PORT 僅為相容路徑。
# ADGUARD_URL=https://192.168.1.250
# ADGUARD_HOST=192.168.1.250
# ADGUARD_PORT=80
# Trusted LAN derives private HTTP/self-signed compatibility; public endpoints stay verified.
ADGUARD_ALLOW_INSECURE_HTTP=false
ADGUARD_TLS_VERIFY=true
# ADGUARD_CA_FILE=/app/config/adguard-ca.pem
# ADGUARD_USER=your_adguard_username
# ADGUARD_PASSWORD=your_adguard_password

# ===== 10. Linux 小主機監控 (選填，SSH) =====
# 填入後啟用「Linux 小主機」頁：CPU/溫度/記憶體/磁碟/負載監控與歷史圖
# LINUX_HOST=192.168.1.37
# LINUX_SSH_PORT=22
# LINUX_SSH_USER=your_linux_username
# LINUX_SSH_PASSWORD=your_linux_password
UCG_SSH_HOST_KEY=
LINUX_SSH_HOST_KEY=
UCG_SSH_ALLOW_UNPINNED=false
LINUX_SSH_ALLOW_UNPINNED=false

# ===== 11. SmartHub 控制台登入與安全設定 =====
# 此區只控制 SmartHub Web 控制台的登入與存取權限，和 UniFi、NAS、UPS 等設備帳密無關；正式對外請使用 HTTPS reverse proxy。
# 部署時請將下列需要的欄位填入 config/.env；NODE_ENV=production 時 PANEL_PASSWORD 必填。
# 管理員帳號可輸入任意名稱（建議 admin）；使用 PANEL_PASSWORD 即取得 admin 權限。
# /health、/healthz、/health/ready 與登入資產公開；其餘頁面/API 需要登入 Session 或相容 Basic Auth
# PANEL_PASSWORD=your_panel_password
# 選填唯讀控制台帳號：登入帳號必須等於 PANEL_READONLY_USERNAME，且密碼必須和管理員密碼不同。
# PANEL_READONLY_USERNAME=readonly
# PANEL_READONLY_PASSWORD=your_distinct_readonly_password
# 登入失敗預設 5 次後冷卻 300 秒；追蹤狀態最多 1000 個來源且會到期清理
# PANEL_AUTH_MAX_FAILURES=5
# PANEL_AUTH_WINDOW_SECONDS=300
# PANEL_AUTH_COOLDOWN_SECONDS=300
# PANEL_AUTH_MAX_CLIENTS=1000
# 匿名核心狀態快照只讀既有記憶體摘要；預設每來源每分鐘最多 30 次，最多追蹤 1000 個來源
# PANEL_PUBLIC_HEALTH_MAX_REQUESTS=30
# PANEL_PUBLIC_HEALTH_WINDOW_SECONDS=60
# PANEL_PUBLIC_HEALTH_MAX_CLIENTS=1000
# 一般 Session 預設 12 小時；勾選「記住登入狀態」預設 30 天；同時保存最多 1000 組 Session
# PANEL_SESSION_IDLE_SECONDS=43200
# PANEL_SESSION_REMEMBER_SECONDS=2592000
# PANEL_SESSION_MAX=1000
# 只有確實位於反向代理後方才設定明確 IP/CIDR；禁止 true、* 或 hop count
# PANEL_TRUSTED_PROXIES=loopback,10.0.0.0/8
# 若外部 HTTPS origin 與後端推導值不同，列出允許的完整 origin（逗號分隔）
# PANEL_ALLOWED_ORIGINS=https://smarthub.example.internal
# Production panel transport policy. Health endpoints remain available for local/container probes.
PANEL_REQUIRE_HTTPS=true
PANEL_ALLOW_INSECURE_HTTP=false

# Public Internet Axios integrations (Site Manager, notifications, Telegram).
# disabled ignores HTTP(S)_PROXY/ALL_PROXY; environment explicitly opts into
# the process proxy environment. LAN integrations always use proxy=false.
SMARTHUB_INTERNET_PROXY_MODE=disabled

# ===== 12. 瀏覽器 Web Push（選填） =====
# 三欄必須同時設定；private key 只放在 config/.env，不可提交或顯示於前端。
# WEB_PUSH_SUBJECT=mailto:ops@example.com
# WEB_PUSH_PUBLIC_KEY=your_url_safe_base64_vapid_public_key
# WEB_PUSH_PRIVATE_KEY=your_url_safe_base64_vapid_private_key
