PORT=3000

# 1. 硬體監控與溫度擷取 (UCG-Ultra 實體機 SSH)
UCG_IP=192.168.1.1
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_ucg_ssh_password

# 2. 本地網路控制 (UniFi Local Controller API 登入)
# 用於控制 WiFi 廣播、PoE 斷電、讀取客戶端與威脅防禦清單
UNIFI_CONTROLLER_URL=https://192.168.1.1:443
UNIFI_USERNAME=your_local_controller_username
UNIFI_PASSWORD=your_local_controller_password

# 3. 雲端備用 (若需切換至 Site Manager API 時填寫)
UNIFI_API_KEY=your_unifi_official_api_key_here
